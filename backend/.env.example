# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT
SECRET_KEY=your_secret_key_change_this_to_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# # Gemini API (support multiple keys)
# GEMINI_API_KEY=your_gemini_api_key
# # Or use numbered keys:
# # GEMINI_KEY_1=key1
# # GEMINI_KEY_2=key2
# # GEMINI_KEY_3=key3

# 会社情報
COMPANY_NAME=
COMPANY_REPRESENTATIVE=
COMPANY_POSTAL_CODE=
COMPANY_ADDRESS1=
COMPANY_ADDRESS2=
COMPANY_BRANCH_NAME=
COMPANY_REGISTRATION_NUMBER=

# 振込先情報
BANK_NAME=
BANK_BRANCH_NAME=
BANK_ACCOUNT_TYPE=普通
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
BANK_YUCHO_SYMBOL=
BANK_YUCHO_NUMBER=

# Google Drive (optional)
GOOGLE_DRIVE_CREDENTIALS=path_to_credentials.json
